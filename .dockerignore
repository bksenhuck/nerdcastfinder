# --- Data inclusion rules ---
# Exclui apenas a pasta de podcasts grandes
backend/data/podcasts/

# Inclui FAISS index e SQLite DB para busca
!backend/data/faiss_index/
!backend/data/faiss_index/**
!backend/data/nerdcasts.db

# Keep frontend/ included na imagem para UI funcionar
!frontend/