# ── GCP Infrastructure ──────────────────────────────────────────────────────
# Obrigatório para os scripts de build/deploy (backend/pipelines/deploy/)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_AR_REPO=api                        # nome do repositório no Artifact Registry
CLOUDRUN_SERVICE=podcast-finder        # nome do serviço no Cloud Run

# ── GCS Bucket ──────────────────────────────────────────────────────────────
# Nome do bucket onde ficam o DB, o índice FAISS e o mapping
GCS_BUCKET=your-bucket-name

# GCS URIs individuais (opcional — se vazios, são derivados de GCS_BUCKET)
FAISS_GCS_URI=gs://your-bucket-name/podcasts.index
FAISS_MAPPING_GCS_URI=gs://your-bucket-name/embedding_id_mapping.npy
FAISS_DB_GCS_URI=gs://your-bucket-name/nerdcasts.db

# ── Runtime (Cloud Run + local) ──────────────────────────────────────────────
LOG_LEVEL=INFO
# CORS_ALLOW_ORIGINS=https://yourdomain.com   # separar por vírgula em produção
